# =============================================
# Chess Platform - Docker Ignore
# =============================================
# Files and directories to exclude from Docker build context
# =============================================

# Dependencies
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Build output
dist
build
*.tsbuildinfo

# Git
.git
.gitignore
.gitattributes
.gitmodules

# Environment files
.env
.env.*
!.env.example

# IDE / Editor
.vscode
.idea
*.swp
*.swo
*~
.DS_Store

# Testing
coverage
.nyc_output
junit.xml
*.lcov

# Documentation
*.md
docs
README*
CHANGELOG*
LICENSE*

# CI/CD
.github
coverage

# Docker (not needed in context)
docker/*.yml
docker/*.conf
docker/*.prod.conf
docker/init-scripts
docker/pgbouncer
docker/redis

# Logs
logs
*.log

# Temporary files
tmp
temp
*.tmp

# Misc
.editorconfig
.prettierrc
.eslintignore
.eslintrc*
.husky
.commitlintrc*
renovate.json
