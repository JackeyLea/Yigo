# =============================================
# Chess Platform - Environment Configuration
# =============================================
# Copy this file to .env and update the values
# =============================================

# Application
NODE_ENV=development
PORT=3000
APP_NAME=Chess Platform
API_PREFIX=/api/v1

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=chess
DB_PASSWORD=chess_secret
DB_NAME=chess_platform_db
DB_SYNC=true
DB_LOGGING=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# RabbitMQ
RABBITMQ_USER=chess
RABBITMQ_PASSWORD=chess_secret
RABBITMQ_URL=amqp://chess:chess_secret@localhost:5672

# Authentication - RS256 Key Directory
# Generate keys with: ssh-keygen -t rsa -b 4096 -f keys/jwt-private.pem -N "" -m PEM
# Then: openssl rsa -in keys/jwt-private.pem -pubout -out keys/jwt-public.pem
JWT_KEYS_DIR=./keys
JWT_EXPIRATION=1h
JWT_REFRESH_EXPIRATION=7d

# Throttling
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Docker Registry
DOCKER_USERNAME=your-docker-username

# Backup (Production)
S3_BACKUP_BUCKET=your-backup-bucket
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_ENDPOINT=https://s3.amazonaws.com
BACKUP_NOTIFICATION_URL=
